{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Jaune",
  "version": "0.1.0",
  "identifier": "space.jaune.desktop",
  "build": {
    "frontendDist": "https://jaune.space",
    "devUrl": "http://localhost:3000"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Jaune",
        "width": 1180,
        "height": 800,
        "minWidth": 420,
        "minHeight": 560,
        "center": true,
        "resizable": true,
        "backgroundColor": "#0A0A0A",
        "titleBarStyle": "Visible"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Productivity",
    "shortDescription": "Your daily brief, one keystroke away.",
    "longDescription": "Jaune is a life OS that learns your patterns and writes you a daily brief. The Mac app keeps it in your menu bar, a hotkey away from wherever you are.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
